# Frontend (Vercel -> Project Settings -> Environment Variables). These are PUBLIC by design.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# Optional fallback only. The server's PAYSTACK_PUBLIC_KEY (see supabase/functions/.env.example) wins.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx

# Optional error reporting
VITE_SENTRY_DSN=
