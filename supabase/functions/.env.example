# SERVER SECRETS - never put these in Vercel or in Git.
# Load them into Supabase with:  npx supabase secrets set --env-file supabase/functions/.env
# (copy this file to supabase/functions/.env first; that path is git-ignored)

PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx

# Email via Resend. Without RESEND_API_KEY all emails are skipped (tickets and payouts still work).
RESEND_API_KEY=

# Payout-request alerts to YOU (the admin).
#   ADMIN_NOTIFY_EMAIL: where alerts go (comma-separate for several). If empty, every admin account is emailed.
#   NOTIFY_EMAIL_FROM: sender for alerts. onboarding@resend.dev works with no domain, but ONLY delivers
#                      to the email you signed up to Resend with.
#   SITE_URL: your live site, used for the "Review & pay" button in the alert.
ADMIN_NOTIFY_EMAIL=you@example.com
NOTIFY_EMAIL_FROM=Faded6 <onboarding@resend.dev>
SITE_URL=https://your-site.vercel.app

# Ticket emails to BUYERS need a sender on a domain you have verified in Resend.
TICKET_EMAIL_FROM=Faded6 <tickets@your-verified-domain.com>
